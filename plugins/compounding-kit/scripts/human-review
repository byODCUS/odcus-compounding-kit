#!/usr/bin/env python3
"""human-review - open an HTML or Markdown file in the browser so a human can
edit the text and comment on parts of it, then hand the batch back to the agent.

Commands:
  human-review <file>                       register + open the file in the browser
  human-review poll <file> [--timeout N] [--ack]   block until feedback arrives
  human-review status [<file>]              instant status, no blocking
  human-review list                         registered pages
  human-review stop                         stop the background server

State lives in ~/.human-review/. Stdlib only.
"""

import argparse
import hashlib
import http.server
import http.cookies
import json
import mimetypes
import os
import pathlib
import re
import secrets
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

STATE_DIR = pathlib.Path.home() / ".human-review"
SERVER_JSON = STATE_DIR / "server.json"
# Files the reviewed page may load from its own folder (relative assets). No dotfiles, no secrets, no scripts to run.
ASSET_SUFFIXES = {".css", ".js", ".mjs", ".map", ".json", ".html", ".htm", ".md", ".txt", ".svg", ".png", ".jpg",
                  ".jpeg", ".gif", ".webp", ".avif", ".ico", ".woff", ".woff2", ".ttf", ".otf", ".mp4", ".webm",
                  ".mp3", ".wav", ".pdf", ".csv"}
STATE_JSON = STATE_DIR / "state.json"
LOG_FILE = STATE_DIR / "server.log"
MD_SUFFIXES = {".md", ".markdown", ".mdown", ".mkd"}


def strip_seq(item):
    return {k: v for k, v in item.items() if k != "_seq"}


def key_for(path: pathlib.Path) -> str:
    return hashlib.sha1(str(path).encode()).hexdigest()[:16]


# --------------------------------------------------------------------------
# minimal markdown -> html (stdlib only)
# --------------------------------------------------------------------------

def esc(s: str) -> str:
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
             .replace('"', "&quot;").replace("'", "&#39;"))


_URL_OK = re.compile(r"^(https?://|mailto:|#|/|\./|\.\./|[A-Za-z0-9_.-])", re.I)
_URL_BAD = re.compile(r"^\s*[a-z][a-z0-9+.-]*:", re.I)


def safe_url(u: str, allow_data_image: bool = False) -> str:
    """Only http(s), mailto, anchors and relative paths survive. Everything else becomes '#'."""
    u = u.strip()
    if allow_data_image and re.match(r"^data:image/(png|jpe?g|gif|webp|svg\+xml);base64,[A-Za-z0-9+/=]+$", u):
        return u
    if _URL_BAD.match(u) and not re.match(r"^(https?://|mailto:)", u, re.I):
        return "#"
    return u if _URL_OK.match(u) else "#"


def inline_md(s: str) -> str:
    s = esc(s)
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    s = re.sub(r"!\[([^\]]*)\]\(([^)\s]+)[^)]*\)",
               lambda m: '<img alt="%s" src="%s">' % (m.group(1), safe_url(m.group(2), True)), s)
    s = re.sub(r"\[([^\]]+)\]\(([^)\s]+)[^)]*\)",
               lambda m: '<a href="%s">%s</a>' % (safe_url(m.group(2)), m.group(1)), s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<!\*)\*([^*\n]+)\*(?!\*)", r"<em>\1</em>", s)
    s = re.sub(r"(?<!_)_([^_\n]+)_(?!_)", r"<em>\1</em>", s)
    s = re.sub(r"~~([^~]+)~~", r"<del>\1</del>", s)
    return s


def md_to_html(text: str) -> str:
    lines = text.replace("\r\n", "\n").split("\n")
    out = []
    i = 0
    para = []

    def flush_para():
        if para:
            out.append("<p>" + inline_md(" ".join(para).strip()) + "</p>")
            para.clear()

    while i < len(lines):
        line = lines[i]
        stripped = line.strip()

        if stripped.startswith("```"):
            flush_para()
            lang = stripped[3:].strip()
            i += 1
            buf = []
            while i < len(lines) and not lines[i].strip().startswith("```"):
                buf.append(lines[i])
                i += 1
            i += 1
            cls = ' class="language-%s"' % esc(lang) if lang else ""
            out.append("<pre><code%s>%s</code></pre>" % (cls, esc("\n".join(buf))))
            continue

        if not stripped:
            flush_para()
            i += 1
            continue

        m = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if m:
            flush_para()
            lvl = len(m.group(1))
            out.append("<h%d>%s</h%d>" % (lvl, inline_md(m.group(2).strip()), lvl))
            i += 1
            continue

        if re.match(r"^(-{3,}|\*{3,}|_{3,})$", stripped):
            flush_para()
            out.append("<hr>")
            i += 1
            continue

        if stripped.startswith(">"):
            flush_para()
            buf = []
            while i < len(lines) and lines[i].strip().startswith(">"):
                buf.append(lines[i].strip().lstrip(">").strip())
                i += 1
            out.append("<blockquote><p>%s</p></blockquote>" % inline_md(" ".join(buf)))
            continue

        if "|" in stripped and i + 1 < len(lines) and re.match(r"^\s*\|?[\s:|-]+\|[\s:|-]*$", lines[i + 1]):
            flush_para()
            def cells(row):
                row = row.strip()
                if row.startswith("|"):
                    row = row[1:]
                if row.endswith("|"):
                    row = row[:-1]
                return [c.strip() for c in row.split("|")]
            head = cells(lines[i])
            i += 2
            body = []
            while i < len(lines) and "|" in lines[i] and lines[i].strip():
                body.append(cells(lines[i]))
                i += 1
            th = "".join("<th>%s</th>" % inline_md(c) for c in head)
            rows = "".join(
                "<tr>%s</tr>" % "".join("<td>%s</td>" % inline_md(c) for c in r) for r in body
            )
            out.append("<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (th, rows))
            continue

        m = re.match(r"^(\s*)([-*+]|\d+[.)])\s+(.*)$", line)
        if m:
            flush_para()
            ordered = not m.group(2) in ("-", "*", "+")
            tag = "ol" if ordered else "ul"
            items = []
            while i < len(lines):
                mm = re.match(r"^(\s*)([-*+]|\d+[.)])\s+(.*)$", lines[i])
                if not mm:
                    if lines[i].strip() and items and lines[i].startswith(("  ", "\t")):
                        items[-1] += " " + lines[i].strip()
                        i += 1
                        continue
                    break
                items.append(mm.group(3).strip())
                i += 1
            out.append("<%s>%s</%s>" % (tag, "".join("<li>%s</li>" % inline_md(x) for x in items), tag))
            continue

        para.append(stripped)
        i += 1

    flush_para()
    return "\n".join(out)


MD_SHELL = """<!DOCTYPE html>
<html lang="de"><head><meta charset="utf-8"><title>__TITLE__</title>
<style>
 body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        max-width: 780px; margin: 56px auto 140px; padding: 0 28px; line-height: 1.65;
        color: #1a1a1a; background: #fff; font-size: 17px; }
 h1,h2,h3,h4 { line-height: 1.25; margin: 1.8em 0 .5em; }
 h1 { font-size: 32px; margin-top: 0; } h2 { font-size: 25px; } h3 { font-size: 20px; }
 code { background: #f1f1f4; padding: 2px 5px; border-radius: 4px; font-size: .9em; }
 pre { background: #f6f6f8; padding: 16px 18px; border-radius: 10px; overflow-x: auto; }
 pre code { background: none; padding: 0; }
 blockquote { border-left: 3px solid #d9d9e0; margin: 1.2em 0; padding: 2px 0 2px 18px; color: #555; }
 table { border-collapse: collapse; width: 100%; margin: 1.2em 0; font-size: 15.5px; }
 th, td { border: 1px solid #e2e2e8; padding: 8px 12px; text-align: left; }
 th { background: #f6f6f8; }
 img { max-width: 100%; } hr { border: none; border-top: 1px solid #e2e2e8; margin: 2em 0; }
</style></head><body>
__BODY__
</body></html>"""


# --------------------------------------------------------------------------
# page building
# --------------------------------------------------------------------------

def build_page(path: pathlib.Path, key: str, token: str) -> bytes:
    raw = path.read_text(encoding="utf-8", errors="replace")
    if path.suffix.lower() in MD_SUFFIXES:
        doc = MD_SHELL.replace("__TITLE__", esc(path.name)).replace("__BODY__", md_to_html(raw))
        kind = "markdown"
    else:
        doc = raw
        kind = "html"

    base_tag = '<base href="/a/%s/">' % key
    low = doc.lower()
    if "<head" in low:
        idx = low.index("<head")
        end = doc.index(">", idx) + 1
        doc = doc[:end] + base_tag + doc[end:]
    elif "<html" in low:
        idx = low.index("<html")
        end = doc.index(">", idx) + 1
        doc = doc[:end] + "<head>" + base_tag + "</head>" + doc[end:]
    else:
        doc = base_tag + doc

    overlay = (
        "\n<style id=\"hr-style\">" + OVERLAY_CSS + "</style>\n"
        "<script id=\"hr-script\">" + OVERLAY_JS
        .replace("__KEY__", key)
        .replace("__TOKEN__", token)
        .replace("__KIND__", kind)
        .replace("__FILE__", json.dumps(str(path))[1:-1])
        + "</script>\n"
    )
    if "</body>" in doc.lower():
        i = doc.lower().rindex("</body>")
        doc = doc[:i] + overlay + doc[i:]
    else:
        doc = doc + overlay
    return doc.encode("utf-8")


# --------------------------------------------------------------------------
# hub (server state)
# --------------------------------------------------------------------------

class Hub:
    def __init__(self):
        self.cond = threading.Condition()
        self.pages = {}
        self.pending = {}
        self.note = ""
        self.drafts = {}
        self.seq = 0
        self.delivered = 0
        self.token = secrets.token_hex(16)        # admin: CLI only (register, poll, list, stop)
        self.page_token = secrets.token_hex(16)   # page: what the reviewed document gets (send, draft, version)
        self.load()

    def load(self):
        try:
            data = json.loads(STATE_JSON.read_text())
        except Exception:
            return
        self.pages = data.get("pages", {}) or {}
        self.pending = data.get("pending", {}) or {}
        self.note = data.get("note", "") or ""

    def save(self):
        STATE_DIR.mkdir(mode=0o700, exist_ok=True)
        tmp = STATE_JSON.with_suffix(".tmp")
        tmp.write_text(json.dumps(
            {"pages": self.pages, "pending": self.pending, "note": self.note, "batches": {}},
            indent=2, ensure_ascii=False))
        tmp.replace(STATE_JSON)

    def register(self, path: pathlib.Path) -> str:
        k = key_for(path)
        with self.cond:
            page = self.pages.get(k, {})
            page.update({"key": k, "file": str(path), "updatedAt": int(time.time() * 1000)})
            page.setdefault("comments", [])
            page.setdefault("edits", [])
            try:
                page["pristine"] = path.read_text(encoding="utf-8", errors="replace")
            except Exception:
                page["pristine"] = ""
            self.pages[k] = page
            self.save()
        return k

    def submit(self, key, comments, edits, note):
        with self.cond:
            slot = self.pending.setdefault(key, {"comments": [], "edits": []})
            for item in list(comments) + list(edits):
                self.seq += 1
                item["_seq"] = self.seq
            slot["comments"].extend(comments)
            slot["edits"].extend(edits)
            if note:
                self.note = (self.note + "\n" + note).strip() if self.note else note
            self.drafts.pop(key, None)
            self.save()
            self.cond.notify_all()

    def snapshot(self, key=None):
        pages = []
        top = self.delivered
        for k, slot in self.pending.items():
            if key and k != key:
                continue
            if not slot.get("comments") and not slot.get("edits"):
                continue
            for item in slot.get("comments", []) + slot.get("edits", []):
                top = max(top, int(item.get("_seq", 0)))
            pages.append({
                "file": self.pages.get(k, {}).get("file", k),
                "comments": [strip_seq(c) for c in slot.get("comments", [])],
                "edits": [strip_seq(e) for e in slot.get("edits", [])],
            })
        self.delivered = top
        return {"status": "feedback", "pages": pages, "overall_note": self.note}

    def has_pending(self, key=None):
        return any(s.get("comments") or s.get("edits")
                   for k, s in self.pending.items() if not key or k == key)

    def clear(self, key=None):
        """Drop only what a previous poll already handed to the agent."""
        if not self.delivered:
            return
        kept = {}
        for k, slot in self.pending.items():
            if key and k != key:
                kept[k] = slot
                continue
            c = [x for x in slot.get("comments", []) if int(x.get("_seq", 0)) > self.delivered]
            e = [x for x in slot.get("edits", []) if int(x.get("_seq", 0)) > self.delivered]
            if c or e:
                kept[k] = {"comments": c, "edits": e}
        self.pending = kept
        if not kept:
            self.note = ""
        self.save()

    def wait(self, timeout, ack, key=None):
        with self.cond:
            if ack:
                self.clear(key)
            deadline = time.time() + timeout
            while not self.has_pending(key):
                left = deadline - time.time()
                if left <= 0:
                    return {"status": "timeout"}
                self.cond.wait(min(left, 5))
            return self.snapshot(key)

    def status(self, key=None):
        with self.cond:
            unsent = {"comments": 0, "edits": 0}
            now = time.time()
            for k, clients in self.drafts.items():
                if key and k != key:
                    continue
                live = [c for c in clients.values() if now - c.get("ts", 0) < 60]
                if not live:
                    continue
                unsent["comments"] += max(int(c.get("comments", 0)) for c in live)
                unsent["edits"] += max(int(c.get("edits", 0)) for c in live)
            if self.has_pending():
                snap = self.snapshot()
                pend = {
                    "comments": sum(len(p["comments"]) for p in snap["pages"]),
                    "edits": sum(len(p["edits"]) for p in snap["pages"]),
                    "pages": len(snap["pages"]),
                }
                return {"status": "feedback-waiting", "pending": pend, "unsent": unsent}
            return {"status": "idle", "unsent": unsent}


HUB = None


# --------------------------------------------------------------------------
# http server
# --------------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "human-review"

    def log_message(self, fmt, *args):
        line = re.sub(r"t=[0-9a-f]{8,}", "t=***", fmt % args)
        sys.stderr.write("%s - %s\n" % (self.log_date_time_string(), line))

    def _send(self, code, body=b"", ctype="application/json; charset=utf-8", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj, ensure_ascii=False), "application/json; charset=utf-8")

    def _auth(self, q):
        """Admin token: the CLI only."""
        return secrets.compare_digest(q.get("t", [""])[0], HUB.token)

    def _page_auth(self, q):
        """Page token (or admin): what the reviewed document may call."""
        t = q.get("t", [""])[0]
        return secrets.compare_digest(t, HUB.page_token) or secrets.compare_digest(t, HUB.token)

    def _cookie_auth(self):
        c = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        v = c["hr"].value if "hr" in c else ""
        return secrets.compare_digest(v, HUB.page_token)

    def _host_ok(self):
        """Refuse DNS-rebinding: only 127.0.0.1 / localhost with our port."""
        host = (self.headers.get("Host") or "").strip().lower()
        port = self.server.server_address[1]
        return host in ("127.0.0.1:%d" % port, "localhost:%d" % port, "[::1]:%d" % port)

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        q = urllib.parse.parse_qs(u.query)
        p = u.path

        if not self._host_ok():
            return self._send(403, "forbidden host", "text/plain; charset=utf-8")

        if p == "/api/ping":
            return self._json({"ok": True, "pid": os.getpid()})

        if p == "/":
            if not self._auth(q):
                return self._send(403, "forbidden", "text/plain; charset=utf-8")
            rows = "".join(
                '<li><a href="/p/%s?t=%s">%s</a></li>' % (k, HUB.page_token, esc(v.get("file", k)))
                for k, v in HUB.pages.items())
            return self._send(200, "<h1>human-review</h1><ul>%s</ul>" % rows, "text/html; charset=utf-8")

        if p.startswith("/p/"):
            key = p[3:].strip("/")
            if not self._page_auth(q):
                return self._send(403, "forbidden", "text/plain; charset=utf-8")
            page = HUB.pages.get(key)
            if not page:
                return self._send(404, "unknown page", "text/plain; charset=utf-8")
            path = pathlib.Path(page["file"])
            if not path.exists():
                return self._send(410, "file gone: %s" % path, "text/plain; charset=utf-8")
            extra = {
                # The reviewed document is untrusted. It may talk to this server only, and never submit forms.
                "Content-Security-Policy": "connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'",
                "Set-Cookie": "hr=%s; Path=/a/; HttpOnly; SameSite=Strict" % HUB.page_token,
                "X-Content-Type-Options": "nosniff",
            }
            return self._send(200, build_page(path, key, HUB.page_token), "text/html; charset=utf-8", extra)

        if p.startswith("/a/"):
            rest = p[3:]
            key, _, rel = rest.partition("/")
            page = HUB.pages.get(key)
            if not page or not (self._cookie_auth() or self._page_auth(q)):
                return self._send(404, "no", "text/plain")
            root = pathlib.Path(page["file"]).parent.resolve()
            rel = urllib.parse.unquote(rel)
            parts = pathlib.PurePosixPath(rel).parts
            if not parts or any(x.startswith(".") for x in parts):
                return self._send(404, "no", "text/plain")
            target = (root / rel).resolve()
            try:
                target.relative_to(root)
            except ValueError:
                return self._send(404, "no", "text/plain")
            if not target.is_file() or target.suffix.lower() not in ASSET_SUFFIXES:
                return self._send(404, "no", "text/plain")
            ctype = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
            return self._send(200, target.read_bytes(), ctype, {"X-Content-Type-Options": "nosniff"})

        if p == "/api/version":
            if not self._page_auth(q):
                return self._json({"error": "forbidden"}, 403)
            page = HUB.pages.get(q.get("key", [""])[0])
            if not page:
                return self._json({"mtime": 0})
            try:
                return self._json({"mtime": int(os.path.getmtime(page["file"]) * 1000)})
            except OSError:
                return self._json({"mtime": 0})

        if p == "/api/poll":
            if not self._auth(q):
                return self._json({"error": "forbidden"}, 403)
            timeout = float(q.get("timeout", ["600"])[0])
            ack = q.get("ack", ["0"])[0] in ("1", "true", "yes")
            return self._json(HUB.wait(timeout, ack, q.get("key", [None])[0]))

        if p == "/api/status":
            if not self._auth(q):
                return self._json({"error": "forbidden"}, 403)
            return self._json(HUB.status(q.get("key", [None])[0]))

        if p == "/api/register":
            if not self._auth(q):
                return self._json({"error": "forbidden"}, 403)
            f = pathlib.Path(q.get("file", [""])[0]).expanduser()
            try:
                f = f.resolve(strict=True)
            except OSError:
                return self._json({"error": "no such file"}, 404)
            if not f.is_file():
                return self._json({"error": "not a file"}, 400)
            key = HUB.register(f)
            return self._json({"key": key, "url": "/p/%s?t=%s" % (key, HUB.page_token)})

        if p == "/api/list":
            if not self._auth(q):
                return self._json({"error": "forbidden"}, 403)
            return self._json({"pages": [{"key": k, "file": v.get("file")} for k, v in HUB.pages.items()]})

        if p == "/api/stop":
            if not self._auth(q):
                return self._json({"error": "forbidden"}, 403)
            self._json({"ok": True})
            threading.Timer(0.2, lambda: os._exit(0)).start()
            return

        return self._send(404, "not found", "text/plain; charset=utf-8")

    def do_POST(self):
        if not self._host_ok():
            return self._json({"error": "forbidden host"}, 403)
        u = urllib.parse.urlsplit(self.path)
        q = urllib.parse.parse_qs(u.query)
        if not self._page_auth(q):
            return self._json({"error": "forbidden"}, 403)
        length = int(self.headers.get("Content-Length", "0") or 0)
        try:
            data = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            data = {}

        if u.path == "/api/send":
            HUB.submit(data.get("key", ""), data.get("comments", []) or [],
                       data.get("edits", []) or [], (data.get("note") or "").strip())
            return self._json({"ok": True})

        if u.path == "/api/draft":
            with HUB.cond:
                slot = HUB.drafts.setdefault(data.get("key", ""), {})
                slot[str(data.get("cid", "-"))] = {
                    "comments": int(data.get("comments", 0)),
                    "edits": int(data.get("edits", 0)),
                    "ts": time.time(),
                }
            return self._json({"ok": True})

        return self._json({"error": "not found"}, 404)


def run_server():
    global HUB
    STATE_DIR.mkdir(mode=0o700, exist_ok=True)
    HUB = Hub()
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    srv.daemon_threads = True
    port = srv.server_address[1]
    SERVER_JSON.write_text(json.dumps({"port": port, "pid": os.getpid(), "token": HUB.token}))
    SERVER_JSON.chmod(0o600)
    sys.stderr.write("human-review listening on 127.0.0.1:%d (pid %d)\n" % (port, os.getpid()))
    sys.stderr.flush()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


# --------------------------------------------------------------------------
# client side
# --------------------------------------------------------------------------

def read_server():
    try:
        return json.loads(SERVER_JSON.read_text())
    except Exception:
        return None


def api(info, path, params=None, body=None, timeout=15):
    qs = dict(params or {})
    qs["t"] = info["token"]
    url = "http://127.0.0.1:%d%s?%s" % (info["port"], path, urllib.parse.urlencode(qs))
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data,
                                 headers={"Content-Type": "application/json"} if data else {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode() or "{}")


def ensure_server(quiet=True):
    info = read_server()
    if info:
        try:
            api(info, "/api/ping", timeout=2)
            return info
        except Exception:
            pass
    STATE_DIR.mkdir(mode=0o700, exist_ok=True)
    log = open(LOG_FILE, "ab")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--serve"],
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                     start_new_session=True, close_fds=True)
    for _ in range(100):
        time.sleep(0.1)
        info = read_server()
        if info:
            try:
                api(info, "/api/ping", timeout=2)
                if not quiet:
                    sys.stderr.write("started server on port %d\n" % info["port"])
                return info
            except Exception:
                continue
    sys.exit("human-review: could not start the server (see %s)" % LOG_FILE)


def cmd_open(args):
    path = pathlib.Path(args.file).expanduser().resolve()
    if not path.is_file():
        sys.exit("human-review: no such file: %s" % path)
    info = ensure_server()
    res = api(info, "/api/register", {"file": str(path)})
    url = "http://127.0.0.1:%d%s" % (info["port"], res["url"])
    if sys.platform == "darwin":
        subprocess.run(["open", url], check=False)
    else:
        import webbrowser
        webbrowser.open(url)
    print(json.dumps({"status": "open", "url": url, "file": str(path)}, ensure_ascii=False))


def cmd_poll(args):
    info = ensure_server()
    params = {"timeout": str(args.timeout), "ack": "1" if args.ack else "0"}
    if args.file:
        path = pathlib.Path(args.file).expanduser().resolve()
        params["key"] = api(info, "/api/register", {"file": str(path)})["key"]
    try:
        res = api(info, "/api/poll", params, timeout=args.timeout + 15)
    except (urllib.error.URLError, socket.timeout, TimeoutError):
        res = {"status": "timeout"}
    print(json.dumps(res, ensure_ascii=False, indent=2))


def cmd_status(args):
    info = read_server()
    if not info:
        print(json.dumps({"status": "idle", "unsent": {"comments": 0, "edits": 0},
                          "server": "stopped"}))
        return
    params = {}
    if args.file:
        params["key"] = key_for(pathlib.Path(args.file).expanduser().resolve())
    try:
        print(json.dumps(api(info, "/api/status", params), ensure_ascii=False))
    except Exception:
        print(json.dumps({"status": "idle", "unsent": {"comments": 0, "edits": 0},
                          "server": "stopped"}))


def cmd_list(args):
    info = read_server()
    if not info:
        print(json.dumps({"pages": []}))
        return
    print(json.dumps(api(info, "/api/list"), ensure_ascii=False, indent=2))


def cmd_stop(args):
    info = read_server()
    if not info:
        print(json.dumps({"ok": True, "note": "not running"}))
        return
    try:
        api(info, "/api/stop", timeout=3)
    except Exception:
        pass
    try:
        SERVER_JSON.unlink()
    except OSError:
        pass
    print(json.dumps({"ok": True}))


def main():
    if "--serve" in sys.argv[1:]:
        return run_server()

    ap = argparse.ArgumentParser(prog="human-review", add_help=True)
    sub = ap.add_subparsers(dest="cmd")

    p_poll = sub.add_parser("poll")
    p_poll.add_argument("file", nargs="?")
    p_poll.add_argument("--timeout", type=float, default=600)
    p_poll.add_argument("--ack", action="store_true")
    p_poll.set_defaults(func=cmd_poll)

    p_st = sub.add_parser("status")
    p_st.add_argument("file", nargs="?")
    p_st.set_defaults(func=cmd_status)

    sub.add_parser("list").set_defaults(func=cmd_list)
    sub.add_parser("stop").set_defaults(func=cmd_stop)

    argv = sys.argv[1:]
    if argv and argv[0] not in ("poll", "status", "list", "stop", "-h", "--help"):
        path_args = argparse.Namespace(file=argv[0])
        return cmd_open(path_args)

    args = ap.parse_args(argv)
    if not getattr(args, "func", None):
        ap.print_help()
        return
    args.func(args)


