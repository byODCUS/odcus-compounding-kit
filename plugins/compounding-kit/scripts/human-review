OVERLAY_JS = r"""
(function () {
  if (window.__hrLoaded) return;
  window.__hrLoaded = true;

  var KEY = "__KEY__", TOKEN = "__TOKEN__", FILE = "__FILE__";
  var BLOCK = ["P","H1","H2","H3","H4","H5","H6","LI","TD","TH","FIGCAPTION","BLOCKQUOTE",
               "DT","DD","SUMMARY","CAPTION","DIV","ARTICLE","SECTION","HEADER","FOOTER","ASIDE","MAIN","NAV"];
  var comments = [], blocks = [], seq = 0, lastMtime = 0, sending = false;
  var CID = Math.random().toString(36).slice(2) + "-" + Date.now();
  var orphans = [];  /* restored edits whose block no longer matches */
  var STORE = "hr-draft:" + KEY;
  function store(obj) {
    try {
      if (obj) localStorage.setItem(STORE, JSON.stringify(obj));
      else localStorage.removeItem(STORE);
    } catch (err) { /* storage blocked, drafts stay in memory only */ }
  }

  function norm(s) { return (s || "").replace(/\s+/g, " ").trim(); }
  function api(path, params, body) {
    var qs = new URLSearchParams(params || {}); qs.set("t", TOKEN);
    return fetch(path + "?" + qs.toString(), body === undefined ? {} : {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body)
    }).then(function (r) { return r.json(); });
  }
  function skipped(el) {
    if (!el || el.nodeType !== 1) return true;
    if (el.id === "hr-panel" || el.id === "hr-compose" || el.id === "hr-bubble" ||
        el.id === "hr-banner" || el.id === "hr-elbtn") return true;
    if (el.closest && (el.closest("#hr-panel") || el.closest("#hr-compose") ||
        el.closest("#hr-banner"))) return true;
    var t = el.tagName;
    if (t === "SCRIPT" || t === "STYLE" || t === "SVG" || t === "svg") return true;
    if (el.closest && el.closest("svg")) return true;
    return false;
  }
  function isBlockish(el) {
    return el.hasAttribute("data-block") || BLOCK.indexOf(el.tagName) >= 0;
  }
  function labelFor(el, text) {
    if (el.getAttribute("data-block")) return el.getAttribute("data-block");
    var c = el.closest("[data-container]");
    var pre = c ? c.getAttribute("data-container") + " / " : "";
    var t = norm(text);
    return pre + (t.length > 46 ? t.slice(0, 46) + "..." : t || el.tagName.toLowerCase());
  }

  function collect() {
    blocks = [];
    var all = document.body.querySelectorAll("*");
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (skipped(el)) continue;
      if (!isBlockish(el)) continue;
      var text = norm(el.textContent);
      if (!text) continue;
      var kids = el.querySelectorAll("*"), busy = false;
      for (var j = 0; j < kids.length; j++) {
        var k = kids[j];
        if (skipped(k)) continue;
        if (isBlockish(k) && norm(k.textContent)) { busy = true; break; }
      }
      if (busy) continue;
      el.setAttribute("contenteditable", "true");
      blocks.push({ el: el, before: text, label: labelFor(el, text) });
    }
  }

  function edits() {
    var out = [];
    for (var i = 0; i < blocks.length; i++) {
      var b = blocks[i];
      if (!b.el.isConnected) continue;
      var after = norm(b.el.textContent);
      if (after !== b.before) out.push({ label: b.label, kind: "edited", before: b.before, after: after });
    }
    return out.concat(orphans);
  }

  /* ---------- panel ---------- */
  var panel = document.createElement("div");
  panel.id = "hr-panel";
  panel.innerHTML =
    '<div class="hr-head"><span class="hr-dot"></span><span class="hr-title">Human Review</span>' +
    '<span class="hr-file"></span><button class="hr-min" title="Einklappen">&#8211;</button></div>' +
    '<div class="hr-body"><div class="hr-counts"></div><div class="hr-list"></div>' +
    '<textarea class="hr-note" placeholder="Allgemeine Notiz (optional)"></textarea>' +
    '<button class="hr-send">Senden</button>' +
    '<div class="hr-hint">Text direkt anklicken und ueberschreiben. Textstelle markieren, um sie zu kommentieren. Entwuerfe ueberleben ein Neuladen, trotzdem alle paar Aenderungen Senden druecken.</div></div>';
  document.body.appendChild(panel);
  panel.querySelector(".hr-file").textContent = FILE.split("/").pop();
  panel.querySelector(".hr-min").onclick = function () { panel.classList.toggle("hr-collapsed"); };

  function render() {
    var e = edits();
    panel.querySelector(".hr-counts").innerHTML =
      "<b>" + comments.length + "</b> Kommentare &middot; <b>" + e.length + "</b> Textaenderungen";
    var list = panel.querySelector(".hr-list");
    list.innerHTML = "";
    comments.forEach(function (c) {
      var d = document.createElement("div");
      d.className = "hr-item";
      var x = document.createElement("span");
      x.className = "x"; x.textContent = "x";
      x.onclick = function () {
        comments = comments.filter(function (o) { return o.id !== c.id; });
        var m = document.querySelector('mark.hr-mark[data-cid="' + c.id + '"]');
        if (m && m.parentNode) { while (m.firstChild) m.parentNode.insertBefore(m.firstChild, m); m.remove(); }
        render(); report();
      };
      var q = document.createElement("div"); q.className = "q"; q.textContent = c.quote;
      var f = document.createElement("div"); f.className = "f"; f.textContent = c.feedback;
      d.appendChild(x); d.appendChild(q); d.appendChild(f);
      list.appendChild(d);
    });
    var btn = panel.querySelector(".hr-send");
    var any = comments.length || e.length || norm(panel.querySelector(".hr-note").value);
    btn.disabled = !any || sending;
    btn.textContent = sending ? "Sende..." : (any ? "Senden" : "Nichts zu senden");
  }

  var reportTimer = null;
  function report() {
    clearTimeout(reportTimer);
    reportTimer = setTimeout(function () {
      saveDraft();
      api("/api/draft", {}, { key: KEY, cid: CID, comments: comments.length, edits: edits().length });
    }, 600);
  }
  function saveDraft() {
    var e = edits(), note = panel.querySelector(".hr-note").value;
    if (!comments.length && !e.length && !norm(note)) { store(null); return; }
    store({ comments: comments, edits: e, note: note, saved: Date.now() });
  }
  function restoreDraft() {
    var d = null;
    try { d = JSON.parse(localStorage.getItem(STORE) || "null"); } catch (err) { d = null; }
    if (!d) return;
    (d.edits || []).forEach(function (e) {
      var hit = null;
      for (var i = 0; i < blocks.length; i++) {
        if (blocks[i].before === e.before && (blocks[i].label === e.label || !hit)) hit = blocks[i];
      }
      if (hit && norm(hit.el.textContent) === hit.before) hit.el.textContent = e.after;
      else orphans.push(e);
    });
    (d.comments || []).forEach(function (c) {
      comments.push(c);
      var n = parseInt(String(c.id || "").replace("c_", ""), 10);
      if (n > seq) seq = n;
    });
    if (d.note) panel.querySelector(".hr-note").value = d.note;
    var head = panel.querySelector(".hr-title");
    head.textContent = "Entwurf wiederhergestellt";
    setTimeout(function () { head.textContent = "Human Review"; }, 3000);
  }
  window.addEventListener("beforeunload", function () { saveDraft(); });

  panel.querySelector(".hr-send").onclick = function () {
    if (sending) return;
    sending = true; render();
    var payload = { key: KEY, comments: comments, edits: edits(),
                    note: panel.querySelector(".hr-note").value };
    api("/api/send", {}, payload).then(function () {
      comments = []; orphans = []; store(null);
      document.querySelectorAll("mark.hr-mark").forEach(function (m) {
        while (m.firstChild) m.parentNode.insertBefore(m.firstChild, m);
        m.remove();
      });
      blocks.forEach(function (b) { if (b.el.isConnected) b.before = norm(b.el.textContent); });
      panel.querySelector(".hr-note").value = "";
      sending = false; render(); report();
      var head = panel.querySelector(".hr-title");
      head.textContent = "Gesendet";
      setTimeout(function () { head.textContent = "Human Review"; }, 2200);
    }).catch(function () { sending = false; render(); });
  };
  panel.querySelector(".hr-note").addEventListener("input", function () { render(); report(); });

  /* ---------- selection comments ---------- */
  var bubble = null, composer = null;
  function killBubble() { if (bubble) { bubble.remove(); bubble = null; } }
  function killComposer() { if (composer) { composer.remove(); composer = null; } }

  document.addEventListener("mouseup", function (ev) {
    if (ev.target.closest && (ev.target.closest("#hr-panel") || ev.target.closest("#hr-compose"))) return;
    setTimeout(function () {
      var sel = window.getSelection();
      if (!sel || sel.isCollapsed || !norm(sel.toString())) { killBubble(); return; }
      var range = sel.getRangeAt(0), rect = range.getBoundingClientRect();
      killBubble();
      bubble = document.createElement("button");
      bubble.id = "hr-bubble";
      bubble.textContent = "Kommentieren";
      bubble.style.left = Math.max(8, Math.min(window.innerWidth - 130, rect.left)) + "px";
      bubble.style.top = Math.max(8, rect.top - 40) + "px";
      bubble.onmousedown = function (e) { e.preventDefault(); };
      bubble.onclick = function () {
        var quote = norm(sel.toString());
        var host = range.commonAncestorContainer;
        if (host.nodeType === 3) host = host.parentElement;
        var ctx = norm(host ? host.textContent : quote);
        var i = ctx.indexOf(quote);
        var anchor = { prefix: i > 0 ? ctx.slice(Math.max(0, i - 50), i) : "",
                       quote: quote,
                       suffix: i >= 0 ? ctx.slice(i + quote.length, i + quote.length + 50) : "" };
        openComposer("selection", quote, anchor, range, rect);
        killBubble();
      };
      document.body.appendChild(bubble);
    }, 0);
  });

  document.addEventListener("mousedown", function (ev) {
    if (bubble && ev.target !== bubble) killBubble();
  });

  function openComposer(kind, quote, anchor, range, rect) {
    killComposer();
    composer = document.createElement("div");
    composer.id = "hr-compose";
    composer.innerHTML = '<div class="q"></div><textarea placeholder="Was soll hier anders sein?"></textarea>' +
      '<div class="row"><button class="no">Abbrechen</button><button class="ok">Speichern</button></div>';
    composer.querySelector(".q").textContent = quote;
    var top = rect ? Math.min(window.innerHeight - 210, Math.max(10, rect.bottom + 10)) : 90;
    var left = rect ? Math.min(window.innerWidth - 316, Math.max(10, rect.left)) : 90;
    composer.style.top = top + "px";
    composer.style.left = left + "px";
    document.body.appendChild(composer);
    var ta = composer.querySelector("textarea");
    ta.focus();
    composer.querySelector(".no").onclick = killComposer;
    composer.querySelector(".ok").onclick = save;
    ta.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) save();
      if (e.key === "Escape") killComposer();
    });
    function save() {
      var txt = ta.value.trim();
      if (!txt) { killComposer(); return; }
      var id = "c_" + (++seq);
      comments.push({ id: id, kind: kind, quote: quote, anchor: anchor, feedback: txt });
      if (range) {
        try {
          var m = document.createElement("mark");
          m.className = "hr-mark"; m.setAttribute("data-cid", id);
          range.surroundContents(m);
        } catch (err) { /* selection crosses elements, skip the highlight */ }
      }
      window.getSelection().removeAllRanges();
      killComposer(); render(); report();
    }
  }

  /* ---------- element comments ---------- */
  var elbtn = null, elTarget = null;
  document.addEventListener("mouseover", function (ev) {
    var c = ev.target.closest ? ev.target.closest("[data-container]") : null;
    if (!c || skipped(c)) return;
    if (elTarget === c && elbtn) return;
    elTarget = c;
    if (elbtn) elbtn.remove();
    var r = c.getBoundingClientRect();
    elbtn = document.createElement("button");
    elbtn.id = "hr-elbtn";
    elbtn.textContent = "Element kommentieren";
    elbtn.style.left = Math.min(window.innerWidth - 170, r.right - 160) + "px";
    elbtn.style.top = Math.max(6, r.top - 26) + "px";
    elbtn.onclick = function () {
      openComposer("element", c.getAttribute("data-container"),
                   { prefix: "", quote: c.getAttribute("data-container"), suffix: "" }, null, r);
      elbtn.remove(); elbtn = null; elTarget = null;
    };
    document.body.appendChild(elbtn);
  });
  document.addEventListener("mouseout", function (ev) {
    if (!elTarget || !elbtn) return;
    var to = ev.relatedTarget;
    if (to && (to === elbtn || (to.closest && (to.closest("[data-container]") === elTarget)))) return;
    elbtn.remove(); elbtn = null; elTarget = null;
  });

  /* ---------- live reload ---------- */
  function dirty() { return comments.length > 0 || edits().length > 0; }
  function banner() {
    if (document.getElementById("hr-banner")) return;
    var b = document.createElement("div");
    b.id = "hr-banner";
    b.textContent = "Neue Version der Datei vorhanden.";
    var btn = document.createElement("button");
    btn.textContent = "Neu laden";
    btn.onclick = function () { location.reload(); };
    b.appendChild(btn);
    document.body.appendChild(b);
  }
  setInterval(function () {
    api("/api/version", { key: KEY }).then(function (r) {
      if (!r || !r.mtime) return;
      if (!lastMtime) { lastMtime = r.mtime; return; }
      if (r.mtime !== lastMtime) {
        lastMtime = r.mtime;
        if (dirty()) banner(); else location.reload();
      }
    }).catch(function () {});
  }, 2000);

  document.addEventListener("input", function (ev) {
    if (ev.target.closest && ev.target.closest("#hr-panel")) return;
    render(); report();
  });

  collect();
  restoreDraft();
  render();
  report();
})();
"""


if __name__ == "__main__":
    main()
